; PossessedWarrior.tscn — Melee bruiser.
; Adds a MeleeHitbox Area2D (rect shape in front of the warrior) that is
; enabled only during the ATTACK state window.

[gd_scene load_steps=6 format=3 uid="uid://possessedwarrior_scene"]

[ext_resource type="Script" path="res://scripts/PossessedWarrior.gd" id="1_pw_script"]

[sub_resource type="PlaceholderTexture2D" id="2_pw_tex"]
size = Vector2(30, 40)

[sub_resource type="RectangleShape2D" id="3_col_shape"]
size = Vector2(30, 40)

[sub_resource type="RectangleShape2D" id="4_melee_shape"]
