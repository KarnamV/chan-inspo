; MiniBoss.tscn — realm-boundary mini-boss.
; Same node layout as PossessedWarrior (MeleeHitbox required by the shared FSM),
; but larger shapes and the MiniBoss.gd script. Stats/scale set in _ready.

[gd_scene load_steps=6 format=3 uid="uid://miniboss_scene"]

[ext_resource type="Script" path="res://scripts/MiniBoss.gd" id="1_mb_script"]

[sub_resource type="PlaceholderTexture2D" id="2_mb_tex"]
size = Vector2(34, 46)

[sub_resource type="RectangleShape2D" id="3_col_shape"]
size = Vector2(34, 46)

[sub_resource type="RectangleShape2D" id="4_melee_shape"]
size = Vector2(48, 36)

[sub_resource type="LabelSettings" id="5_label_settings"]
font_size = 11
font_color = Color(1.0, 0.85, 0.9, 1.0)
outline_size = 3
outline_color = Color(0.0, 0.0, 0.0, 1.0)

[node name="MiniBoss" type="CharacterBody2D"]
script = ExtResource("1_mb_script")

[node name="Sprite2D" type="Sprite2D" parent="."]
modulate = Color(0.85, 0.15, 0.55, 1.0)
texture = SubResource("2_mb_tex")
offset = Vector2(0, -12)

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("3_col_shape")
position = Vector2(0, -12)

[node name="HPLabel" type="Label" parent="."]
position = Vector2(-32, -78)
size = Vector2(64, 16)
label_settings = SubResource("5_label_settings")
text = "HP: 240/240"
horizontal_alignment = 1

[node name="MeleeHitbox" type="Area2D" parent="."]
position = Vector2(0, 32)
monitoring = false
monitorable = false

[node name="MeleeShape" type="CollisionShape2D" parent="MeleeHitbox"]
shape = SubResource("4_melee_shape")
disabled = true
