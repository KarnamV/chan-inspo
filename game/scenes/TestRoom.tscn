; ---------------------------------------------------------------------------
; TestRoom.tscn — isolated combat-feel test room.
;
; Purpose: Verify all 4 attacks + counter attacks register hits, flash red,
;          update HP labels, and destroy dummies cleanly.
;
; Layout (1280x720 viewport, walls 20px thick):
;   Floor: 1240x680, offset (20, 20)
;   Walls: ColorRect (visual) + StaticBody2D (physical) for each border
;   5 Dummies: corner-spread + centre-north so all reach ranges are testable
;   Player: starts at room centre (640, 360)
;
; Damage routing: TestRoom.gd connects player.attack_landed -> finds nearest
;   dummy within 120px of hit_position and calls take_damage(damage).
; ---------------------------------------------------------------------------

[node name="TestRoom" type="Node2D"]
script = ExtResource("3_testroom_script")

[node name="Floor" type="ColorRect" parent="."]
color = Color(0.12, 0.12, 0.14, 1.0)
position = Vector2(20, 20)
size = Vector2(1240, 680)

[node name="WallTop" type="ColorRect" parent="."]
color = Color(0.25, 0.18, 0.10, 1.0)
position = Vector2(0, 0)
size = Vector2(1280, 20)

[node name="WallTopBody" type="StaticBody2D" parent="."]
position = Vector2(640, 10)

[node name="WallTopShape" type="CollisionShape2D" parent="WallTopBody"]
