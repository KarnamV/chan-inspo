[gd_scene load_steps=6 format=3 uid="uid://testroom_scene"]

[ext_resource type="PackedScene" path="res://scenes/Player.tscn" id="1_player_scene"]
[ext_resource type="PackedScene" path="res://scenes/Dummy.tscn" id="2_dummy_scene"]
[ext_resource type="Script" path="res://scripts/TestRoom.gd" id="3_testroom_script"]
[ext_resource type="PackedScene" path="res://scenes/RoomRenderer.tscn" id="4_roomrenderer_scene"]
[ext_resource type="Script" path="res://scripts/RoomManager.gd" id="5_roommanager_script"]

[sub_resource type="LabelSettings" id="8_stance_label_settings"]
font_size = 20
font_color = Color(1.0, 1.0, 1.0, 1.0)
shadow_color = Color(0.0, 0.0, 0.0, 0.8)
shadow_offset = Vector2(2, 2)

; ---------------------------------------------------------------------------
; TestRoom.tscn — isolated combat-feel test room with room transitions.
;
; Node hierarchy:
;   TestRoom (Node2D)
;     ├── RoomRenderer   — draws floor + coloured walls + exit door arches
;     ├── RoomManager    — holds RoomGraph, drives fade transitions
;     ├── Dummies        — combat dummies (kept for hit-testing; AI replaces later)
;     ├── Player         — player character at room centre
;     └── HUD (CanvasLayer, layer=10)
;           └── StanceLabel
;
; Static floor/walls removed — RoomRenderer builds them procedurally.
; RoomManager is wired up in TestRoom._setup_room_manager() with seed 42.
; ---------------------------------------------------------------------------

[node name="TestRoom" type="Node2D"]
script = ExtResource("3_testroom_script")

[node name="RoomRenderer" parent="." instance=ExtResource("4_roomrenderer_scene")]
position = Vector2(0, 0)

[node name="RoomManager" type="Node" parent="."]
script = ExtResource("5_roommanager_script")

[node name="Dummies" type="Node2D" parent="."]

[node name="DummyNW" parent="Dummies" instance=ExtResource("2_dummy_scene")]
position = Vector2(280, 200)

[node name="DummyNE" parent="Dummies" instance=ExtResource("2_dummy_scene")]
position = Vector2(1000, 200)

[node name="DummyCenter" parent="Dummies" instance=ExtResource("2_dummy_scene")]
position = Vector2(640, 280)

[node name="DummySW" parent="Dummies" instance=ExtResource("2_dummy_scene")]
position = Vector2(280, 520)

[node name="DummySE" parent="Dummies" instance=ExtResource("2_dummy_scene")]
position = Vector2(1000, 520)

[node name="Player" parent="." instance=ExtResource("1_player_scene")]
position = Vector2(640, 360)

; CanvasLayer keeps the HUD anchored to the viewport regardless of camera movement.
[node name="HUD" type="CanvasLayer" parent="."]
layer = 10

[node name="StanceLabel" type="Label" parent="HUD"]
; Top-left corner, 12px padding from each edge.
anchors_preset = 0
position = Vector2(12, 12)
size = Vector2(280, 32)
label_settings = SubResource("8_stance_label_settings")
text = "☯ LIGHT"
