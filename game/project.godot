; Engine configuration file.
config_version=5

[application]

config/name="Demon Realm Escape"
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
run/main_scene="res://scenes/run/intro.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Inputs="*res://scripts/core/inputs.gd"
Events="*res://scripts/core/events.gd"
Juice="*res://scripts/core/juice.gd"
Meta="*res://scripts/run/meta.gd"
Run="*res://scripts/run/run_state.gd"
AssetCache="*res://scripts/core/asset_cache.gd"
Fade="*res://scripts/core/fade.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="prop"
3d_physics/layer_5="hitbox"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="interact"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/ssao/quality=3
environment/ssao/half_size=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true

[gui]

theme/custom="res://assets/ui/theme.tres"
